<Window x:Class="KerfixDesktop.EditarClienteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editar cliente - KerFix Manager"
        Width="450"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F1F5F9"
        FontFamily="Segoe UI">

    <Border Background="White"
            Margin="20"
            Padding="25"
            CornerRadius="12"
            BorderBrush="#DEE5EF"
            BorderThickness="1">

        <StackPanel>

            <!-- TÍTULO -->
            <TextBlock Text="Editar cliente"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#142443"
                       Margin="0,0,0,25"/>

            <!-- NOMBRE -->
            <TextBlock Text="Nombre"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#253650"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="TxtNombre"
                     Height="42"
                     FontSize="14"
                     Padding="12,8"
                     BorderBrush="#CBD5E1"
                     Margin="0,0,0,20"/>

            <!-- TELÉFONO -->
            <TextBlock Text="Teléfono"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#253650"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="TxtTelefono"
                     Height="42"
                     FontSize="14"
                     Padding="12,8"
                     BorderBrush="#CBD5E1"
                     Margin="0,0,0,25"/>

            <!-- BOTONES -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Height="43"
                        Background="#E2E8F0"
                        Foreground="#253650"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Cancelar_Click"/>

                <Button Grid.Column="2"
                        Content="Guardar cambios"
                        Height="43"
                        Background="#0866CC"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Guardar_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
