<UserControl x:Class="KerfixDesktop.NuevoRegistroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1050"
             d:DesignHeight="720"
             Background="#F1F5F9"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#253650"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Campo" TargetType="TextBox">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
        </Style>

        <Style x:Key="Lista" TargetType="ComboBox">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="BotonModo" TargetType="RadioButton">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#142443"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <StackPanel Grid.Row="0" Margin="0,0,0,22">

                <TextBlock Text="Nuevo registro"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="#122244"/>

                <TextBlock Text="Ingreso de equipos al servicio técnico"
                           FontSize="15"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- FORMULARIO PRINCIPAL -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#DCE4F0"
                    BorderThickness="1"
                    Padding="26"
                    MaxWidth="850"
                    HorizontalAlignment="Stretch">

                <StackPanel>

                    <!-- SELECCIÓN DE CLIENTE -->
                    <TextBlock Text="Datos del cliente"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#142443"
                               Margin="0,0,0,18"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,24">

                        <RadioButton x:Name="RbNuevoCliente"
                                     Content="Nuevo cliente"
                                     GroupName="ModoCliente"
                                     Style="{StaticResource BotonModo}"
                                     IsChecked="True"
                                     Checked="ModoCliente_Checked"/>

                        <RadioButton x:Name="RbClienteExistente"
                                     Content="Cliente existente"
                                     GroupName="ModoCliente"
                                     Style="{StaticResource BotonModo}"
                                     Checked="ModoCliente_Checked"/>

                    </StackPanel>

                    <!-- ========================= -->
                    <!-- NUEVO CLIENTE -->
                    <!-- ========================= -->
                    <StackPanel x:Name="PanelNuevoCliente">

                        <TextBlock Text="Nombre"
                                   Style="{StaticResource Etiqueta}"/>

                        <TextBox x:Name="TxtNombreNuevo"
                                 Style="{StaticResource Campo}"
                                 Margin="0,0,0,18"/>

                        <TextBlock Text="Teléfono"
                                   Style="{StaticResource Etiqueta}"/>

                        <TextBox x:Name="TxtTelefonoNuevo"
                                 Style="{StaticResource Campo}"
                                 Margin="0,0,0,18"/>

                    </StackPanel>

                    <!-- ========================= -->
                    <!-- CLIENTE EXISTENTE -->
                    <!-- ========================= -->
                    <StackPanel x:Name="PanelClienteExistente"
                                Visibility="Collapsed">

                        <TextBlock Text="Seleccionar cliente"
                                   Style="{StaticResource Etiqueta}"/>

                        <ComboBox x:Name="CmbClienteExistente"
                                  Style="{StaticResource Lista}"
                                  DisplayMemberPath="Nombre"
                                  SelectionChanged="ClienteExistente_SelectionChanged"
                                  Margin="0,0,0,18"/>

                        <TextBlock x:Name="TxtTelefonoExistente"
                                   Foreground="#64748B"
                                   FontSize="13"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Equipo del cliente"
                                   Style="{StaticResource Etiqueta}"/>

                        <ComboBox x:Name="CmbEquipoExistente"
                                  Style="{StaticResource Lista}"
                                  DisplayMemberPath="Descripcion"
                                  SelectionChanged="EquipoExistente_SelectionChanged"
                                  Margin="0,0,0,18"/>

                    </StackPanel>

                    <!-- ========================= -->
                    <!-- DATOS DEL EQUIPO NUEVO -->
                    <!-- ========================= -->
                    <StackPanel x:Name="PanelEquipoNuevo">

                        <Border Background="#E2E8F0"
                                Height="1"
                                Margin="0,3,0,20"/>

                        <TextBlock Text="Datos del equipo"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#142443"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Tipo de equipo"
                                   Style="{StaticResource Etiqueta}"/>

                        <ComboBox x:Name="CmbTipoEquipo"
                                  Style="{StaticResource Lista}"
                                  Margin="0,0,0,18">

                            <ComboBoxItem Content="Notebook"/>
                            <ComboBoxItem Content="PC Escritorio"/>
                            <ComboBoxItem Content="All-in-One"/>
                            <ComboBoxItem Content="Impresora"/>
                            <ComboBoxItem Content="Monitor"/>
                            <ComboBoxItem Content="Otro"/>

                        </ComboBox>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Marca"
                                           Style="{StaticResource Etiqueta}"/>

                                <TextBox x:Name="TxtMarca"
                                         Style="{StaticResource Campo}"/>

                            </StackPanel>

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Modelo"
                                           Style="{StaticResource Etiqueta}"/>

                                <TextBox x:Name="TxtModelo"
                                         Style="{StaticResource Campo}"/>
                    
                            </StackPanel>
                            
                        </Grid>
                        <TextBlock Text="Número de serie"
           Style="{StaticResource Etiqueta}"/>

                        <TextBox x:Name="TxtSerie"
         Style="{StaticResource Campo}"
         Margin="0,0,0,18"/>
                    </StackPanel>

                    <!-- DIAGNÓSTICO Y ESTADO -->
                    <Border Background="#E2E8F0"
                            Height="1"
                            Margin="0,5,0,20"/>

                    <TextBlock Text="Información del registro"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#142443"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Diagnóstico del cliente"
                               Style="{StaticResource Etiqueta}"/>

                    <TextBox x:Name="TxtDiagnostico"
                             Height="100"
                             Padding="12"
                             FontSize="14"
                             BorderBrush="#CBD5E1"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Margin="0,0,0,22"/>

                    <TextBlock Text="Estado inicial"
                               Style="{StaticResource Etiqueta}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,5,0,28">

                        <RadioButton x:Name="RbRevisar"
                                     Content="Revisar"
                                     GroupName="EstadoRegistro"
                                     FontSize="14"
                                     Margin="0,0,30,0"/>

                        <RadioButton x:Name="RbPendiente"
                                     Content="Dejar pendiente"
                                     GroupName="EstadoRegistro"
                                     IsChecked="True"
                                     FontSize="14"/>

                    </StackPanel>

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,0,0,22"/>

                    <!-- BOTONES -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="Cancelar"
                                Width="145"
                                Height="44"
                                Background="#E2E8F0"
                                Foreground="#253650"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,12,0"
                                Click="Cancelar_Click"/>

                        <Button Content="Guardar registro"
                                Width="170"
                                Height="44"
                                Background="#0866CC"
                                Foreground="White"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="Guardar_Click"/>

                    </StackPanel>

                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
