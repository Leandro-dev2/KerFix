<UserControl x:Class="KerfixDesktop.DespachoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="740"
             Background="#F1F5F9"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- TARJETAS -->
        <Style x:Key="Tarjeta" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DCE4F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- ETIQUETAS -->
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- BOTONES AZULES -->
        <Style x:Key="BotonAzul" TargetType="Button">
            <Setter Property="Height" Value="39"/>
            <Setter Property="Background" Value="#0866CC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <!-- ESTRUCTURA PRINCIPAL -->
    <Grid Margin="24,20,24,18">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.25*" MinWidth="370"/>
        </Grid.ColumnDefinitions>

        <!-- =================================== -->
        <!-- LADO IZQUIERDO -->
        <!-- =================================== -->

        <Grid Grid.Column="0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <StackPanel Margin="0,0,0,22">

                <TextBlock Text="Despachos"
                           FontSize="29"
                           FontWeight="Bold"
                           Foreground="#122244"/>

                <TextBlock Text="Finalización y entrega de equipos"
                           FontSize="15"
                           Foreground="#64748B"
                           Margin="0,4,0,0"/>

            </StackPanel>

            <!-- ESTADÍSTICAS -->
            <Grid Grid.Row="1" Margin="0,0,0,18">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- POR PREPARAR -->
                <Border Grid.Column="0"
                        Style="{StaticResource Tarjeta}"
                        Background="#E1ECFF">

                    <StackPanel>

                        <TextBlock Text="Por preparar"
                                   Foreground="#253650"/>

                        <TextBlock x:Name="TxtPorPreparar"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#122244"
                                   Margin="0,6,0,0"/>

                    </StackPanel>
                </Border>

                <!-- PREPARADOS -->
                <Border Grid.Column="2"
                        Style="{StaticResource Tarjeta}"
                        Background="#E6F5EC">

                    <StackPanel>

                        <TextBlock Text="Despachos preparados"
                                   Foreground="#253650"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="TxtPreparados"
                                   Text="0"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#122244"
                                   Margin="0,6,0,0"/>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- =================================== -->
            <!-- BUSCADOR Y FILTRO -->
            <!-- =================================== -->

            <Grid Grid.Row="2" Margin="0,0,0,16">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <!-- BUSCADOR -->
                <TextBox x:Name="TxtBuscarDespacho"
                         Grid.Column="0"
                         Height="43"
                         Padding="12,9"
                         FontSize="14"
                         BorderBrush="#CBD5E1"
                         ToolTip="Buscar por registro, cliente o equipo"
                         TextChanged="Buscar_TextChanged"/>

                <!-- BOTÓN FILTRAR -->
                <Button x:Name="BtnFiltrarDespacho"
                        Grid.Column="2"
                        Content="Filtrar ▾"
                        Height="43"
                        Background="White"
                        BorderBrush="#CBD5E1"
                        Cursor="Hand"
                        Click="BtnFiltrarDespacho_Click">

                    <Button.ContextMenu>

                        <ContextMenu>

                            <MenuItem Header="Todos"
                                      Tag="Todos"
                                      Click="FiltroDespacho_Click"/>

                            <MenuItem Header="Por preparar"
                                      Tag="Por preparar"
                                      Click="FiltroDespacho_Click"/>

                            <MenuItem Header="Preparados"
                                      Tag="Preparados"
                                      Click="FiltroDespacho_Click"/>

                        </ContextMenu>

                    </Button.ContextMenu>
                </Button>

            </Grid>

            <!-- =================================== -->
            <!-- TABLA DE DESPACHOS -->
            <!-- =================================== -->

            <Border Grid.Row="3"
                    Style="{StaticResource Tarjeta}"
                    Padding="10">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtCantidadMostrada"
                               Text="Mostrando: 0 registros"
                               Foreground="#64748B"
                               FontSize="13"
                               Margin="4,0,0,12"/>

                    <DataGrid x:Name="TablaDespachos"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="TablaDespachos_SelectionChanged"
                              HeadersVisibility="Column"
                              RowHeight="45"
                              ColumnHeaderHeight="42"
                              AlternatingRowBackground="#F8FAFC"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              BorderBrush="#DCE3EC"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="White">

                        <DataGrid.Columns>

                            <DataGridTextColumn
                                Header="Registro"
                                Binding="{Binding RegistroTexto}"
                                Width="85"/>

                            <DataGridTextColumn
                                Header="Cliente"
                                Binding="{Binding Cliente}"
                                Width="145"/>

                            <DataGridTextColumn
                                Header="Equipo"
                                Binding="{Binding Equipo}"
                                Width="140"/>

                            <DataGridTextColumn
                                Header="Total"
                                Binding="{Binding TotalTexto}"
                                Width="95"/>

                            <DataGridTextColumn
                                Header="Situación"
                                Binding="{Binding Situacion}"
                                Width="105"/>

                        </DataGrid.Columns>
                    </DataGrid>

                </Grid>
            </Border>

        </Grid>

        <!-- =================================== -->
        <!-- PANEL DERECHO -->
        <!-- =================================== -->

        <Border Grid.Column="2"
                Style="{StaticResource Tarjeta}"
                Padding="18">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- INFORMACIÓN DEL REGISTRO -->
                <StackPanel Grid.Row="0">

                    <TextBlock x:Name="TxtTituloRegistro"
                               Text="Selecciona un registro"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#122244"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="TxtCliente"
                               FontSize="14"
                               Foreground="#253650"
                               TextWrapping="Wrap"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="TxtEquipo"
                               FontSize="14"
                               Foreground="#253650"
                               TextWrapping="Wrap"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="TxtFecha"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="TxtSituacion"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#0866CC"
                               Margin="0,0,0,15"/>

                    <Border Height="1"
                            Background="#E2E8F0"
                            Margin="0,0,0,14"/>

                </StackPanel>

                <!-- CONTENIDO DINÁMICO -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid>

                        <!-- =================================== -->
                        <!-- DETALLE DEL DESPACHO -->
                        <!-- =================================== -->

                        <StackPanel x:Name="PanelDetalle">

                            <TextBlock Text="Detalle del despacho"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#122244"
                                       Margin="0,0,0,16"/>

                            <TextBlock
                                Text="Trabajo, observaciones y recomendaciones"
                                Style="{StaticResource Etiqueta}"
                                TextWrapping="Wrap"/>

                            <TextBlock x:Name="TxtObservacionesDetalle"
                                       TextWrapping="Wrap"
                                       Foreground="#253650"
                                       Margin="0,7,0,20"/>

                            <TextBlock Text="Servicios y componentes"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#122244"
                                       Margin="0,0,0,12"/>

                            <!-- DETALLES CONFIRMADOS -->
                            <ItemsControl x:Name="ListaDetalleLectura">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border Background="#F8FAFC"
                                                BorderBrush="#DFE5ED"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="10"
                                                Margin="0,0,0,7">

                                            <StackPanel>

                                                <TextBlock
                                                    Text="{Binding Descripcion}"
                                                    FontWeight="SemiBold"
                                                    TextWrapping="Wrap"/>

                                                <TextBlock
                                                    Text="{Binding ResumenPrecio}"
                                                    Foreground="#64748B"
                                                    TextWrapping="Wrap"
                                                    Margin="0,4,0,0"/>

                                            </StackPanel>
                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <!-- TOTAL -->
                            <TextBlock x:Name="TxtTotalDetalle"
                                       Text="Total: $0"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="#0866CC"
                                       Margin="0,20,0,20"/>

                            <!-- ACCIONES -->
                            <StackPanel>

                                <Button x:Name="BtnPrepararEditar"
                                        Content="Preparar despacho"
                                        Style="{StaticResource BotonAzul}"
                                        Click="PrepararEditar_Click"
                                        Margin="0,0,0,10"/>

                                <Button x:Name="BtnGenerarPdf"
                                        Content="Generar PDF"
                                        Height="43"
                                        Background="#E1ECFF"
                                        Foreground="#0866CC"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="GenerarPdf_Click"/>

                            </StackPanel>

                        </StackPanel>

                        <!-- =================================== -->
                        <!-- FORMULARIO PREPARAR / EDITAR -->
                        <!-- =================================== -->

                        <StackPanel x:Name="PanelFormulario"
                                    Visibility="Collapsed">

                            <TextBlock x:Name="TxtTituloFormulario"
                                       Text="Preparar despacho"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       Foreground="#122244"
                                       Margin="0,0,0,16"/>

                            <!-- OBSERVACIONES -->
                            <TextBlock
                                Text="Trabajo realizado, observaciones y recomendaciones"
                                Style="{StaticResource Etiqueta}"
                                TextWrapping="Wrap"
                                Margin="0,0,0,7"/>

                            <TextBox x:Name="TxtObservaciones"
                                     Height="100"
                                     Padding="10"
                                     BorderBrush="#CBD5E1"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,18"/>

                            <!-- AGREGAR SERVICIO -->
                            <TextBlock Text="Agregar servicio"
                                       FontWeight="SemiBold"
                                       Foreground="#122244"
                                       Margin="0,0,0,7"/>

                            <ComboBox x:Name="CmbServicios"
                                      Height="38"
                                      DisplayMemberPath="Nombre"
                                      Margin="0,0,0,7"/>

                            <Grid Margin="0,0,0,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtCantidadServicio"
                                         Grid.Column="0"
                                         Height="36"
                                         Padding="8"
                                         Text="1"
                                         ToolTip="Cantidad de servicios"/>

                                <Button Grid.Column="2"
                                        Content="+ Agregar"
                                        Style="{StaticResource BotonAzul}"
                                        Click="AgregarServicio_Click"/>

                            </Grid>

                            <!-- AGREGAR COMPONENTE -->
                            <TextBlock Text="Agregar componente"
                                       FontWeight="SemiBold"
                                       Foreground="#122244"
                                       Margin="0,0,0,7"/>

                            <ComboBox x:Name="CmbComponentes"
                                      Height="38"
                                      DisplayMemberPath="Nombre"
                                      Margin="0,0,0,7"/>

                            <Grid Margin="0,0,0,16">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="130"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="TxtCantidadComponente"
                                         Grid.Column="0"
                                         Height="36"
                                         Padding="8"
                                         Text="1"
                                         ToolTip="Cantidad de componentes"/>

                                <Button Grid.Column="2"
                                        Content="+ Agregar"
                                        Style="{StaticResource BotonAzul}"
                                        Click="AgregarComponente_Click"/>

                            </Grid>

                            <!-- TABLA DE DETALLES -->
                            <TextBlock Text="Detalle del cobro"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="#122244"
                                       Margin="0,0,0,10"/>

                            <DataGrid x:Name="TablaDetalles"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      Height="185"
                                      RowHeight="35"
                                      BorderBrush="#CBD5E1"
                                      HorizontalScrollBarVisibility="Auto"
                                      Margin="0,0,0,14">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="Descripción"
                                        Binding="{Binding Descripcion}"
                                        Width="165"/>

                                    <DataGridTextColumn
                                        Header="Cant."
                                        Binding="{Binding Cantidad}"
                                        Width="45"/>

                                    <DataGridTextColumn
                                        Header="Subtotal"
                                        Binding="{Binding SubtotalTexto}"
                                        Width="100"/>

                                    <DataGridTemplateColumn
                                        Header=""
                                        Width="43">

                                        <DataGridTemplateColumn.CellTemplate>

                                            <DataTemplate>

                                                <Button Content="✕"
                                                        Foreground="#DC3545"
                                                        Tag="{Binding}"
                                                        Click="QuitarDetalle_Click"/>

                                            </DataTemplate>

                                        </DataGridTemplateColumn.CellTemplate>

                                    </DataGridTemplateColumn>

                                </DataGrid.Columns>

                            </DataGrid>

                            <!-- TOTAL -->
                            <Border Background="#E1ECFF"
                                    CornerRadius="8"
                                    Padding="14"
                                    Margin="0,0,0,18">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Total del despacho"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="#122244"/>

                                    <TextBlock x:Name="TxtTotalFormulario"
                                               Grid.Column="1"
                                               Text="$0"
                                               FontSize="21"
                                               FontWeight="Bold"
                                               Foreground="#0866CC"/>

                                </Grid>

                            </Border>

                            <!-- GUARDAR / CANCELAR -->
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Content="Cancelar"
                                        Height="43"
                                        Background="#E2E8F0"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="Cancelar_Click"/>

                                <Button Grid.Column="2"
                                        Content="Guardar despacho"
                                        Style="{StaticResource BotonAzul}"
                                        Click="GuardarDespacho_Click"/>

                            </Grid>

                        </StackPanel>

                    </Grid>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</UserControl>
