<UserControl x:Class="KerfixDesktop.RegistroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="720"
             Background="#F1F5F9"
             FontFamily="Segoe UI">

    <UserControl.Resources>

        <!-- TARJETAS -->
        <Style x:Key="TarjetaRegistro"
               TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#DCE4F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- ETIQUETAS DEL DETALLE -->
        <Style x:Key="EtiquetaDetalle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- VALORES DEL DETALLE -->
        <Style x:Key="ValorDetalle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#142443"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ESTILO DE LA TABLA -->
        <Style x:Key="TextoCelda"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="25,22,25,20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,22">

            <TextBlock Text="Registros"
                       FontSize="29"
                       FontWeight="Bold"
                       Foreground="#122244"/>

            <TextBlock Text="Ingreso y seguimiento de equipos"
                       FontSize="15"
                       Foreground="#64748B"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ESTADÍSTICAS -->
        <Grid Grid.Row="1"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <!-- PENDIENTES -->
            <Border Grid.Column="0"
                    Style="{StaticResource TarjetaRegistro}"
                    Background="#E1ECFF">

                <StackPanel>
                    <TextBlock Text="Pendientes"
                               FontSize="14"
                               Foreground="#253650"/>

                    <TextBlock x:Name="TxtPendientes"
                               Text="0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#122244"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- EN REPARACIÓN -->
            <Border Grid.Column="2"
                    Style="{StaticResource TarjetaRegistro}"
                    Background="#E1ECFF">

                <StackPanel>
                    <TextBlock Text="En reparación"
                               FontSize="14"
                               Foreground="#253650"/>

                    <TextBlock x:Name="TxtEnReparacion"
                               Text="0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#122244"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- NUEVO REGISTRO -->
            <Button Grid.Column="4"
                    Content="＋  Nuevo registro"
                    Height="52"
                    VerticalAlignment="Center"
                    Background="#0866CC"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="NuevoRegistro_Click"/>
        </Grid>

        <!-- BUSCADOR Y FILTRO -->
        <Grid Grid.Row="2"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="175"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtBuscarRegistro"
                     Grid.Column="0"
                     Height="43"
                     Padding="12,10"
                     FontSize="14"
                     BorderBrush="#CBD5E1"
                     ToolTip="Buscar por ID, cliente, equipo o diagnóstico"
                     TextChanged="TxtBuscarRegistro_TextChanged"/>

            <Button x:Name="BtnFiltrarRegistro"
                    Grid.Column="2"
                    Content="Filtrar por estado ▾"
                    Height="43"
                    FontSize="13"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    Cursor="Hand"
                    Click="BtnFiltrarRegistro_Click">

                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Todos"
                                  Tag="Todos"
                                  Click="FiltroRegistro_Click"/>

                                        <MenuItem Header="Pendiente"
                                  Tag="Pendiente"
                                  Click="FiltroRegistro_Click"/>

                                        <MenuItem Header="En revisión"
                                  Tag="En revisión"
                                  Click="FiltroRegistro_Click"/>

                                        <MenuItem Header="Completado"
                                  Tag="Completado"
                                  Click="FiltroRegistro_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- TABLA Y PANEL DERECHO -->
        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"
                                  MinWidth="300"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- LISTADO DE REGISTROS -->
            <Border Grid.Column="0"
                    Style="{StaticResource TarjetaRegistro}"
                    Padding="12">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtMostrandoRegistros"
                               Text="Mostrando: 0 registros"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="3,0,0,14"/>

                    <DataGrid x:Name="TablaRegistros"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="TablaRegistros_SelectionChanged"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              RowHeight="44"
                              ColumnHeaderHeight="42"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E2E8F0"
                              AlternatingRowBackground="#F8FAFC"
                              BorderBrush="#DCE3EC"
                              BorderThickness="1"
                              Background="White">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="N.º"
                                                Binding="{Binding Id}"
                                                Width="55"
                                                ElementStyle="{StaticResource TextoCelda}"/>

                            <DataGridTextColumn Header="Cliente"
                                                Binding="{Binding Cliente}"
                                                Width="170"
                                                ElementStyle="{StaticResource TextoCelda}"/>

                            <DataGridTextColumn Header="Fecha recepción"
                                                Binding="{Binding FechaRecepcion, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="115"
                                                ElementStyle="{StaticResource TextoCelda}"/>

                            <DataGridTextColumn Header="Tipo"
                                                Binding="{Binding Tipo}"
                                                Width="110"
                                                ElementStyle="{StaticResource TextoCelda}"/>

                            <DataGridTextColumn Header="Marca"
                                                Binding="{Binding Marca}"
                                                Width="100"
                                                ElementStyle="{StaticResource TextoCelda}"/>

                            <DataGridTextColumn Header="Modelo"
                                                Binding="{Binding Modelo}"
                                                Width="150"
                                                ElementStyle="{StaticResource TextoCelda}"/>

                            <DataGridTextColumn Header="Diagnóstico"
                                                Binding="{Binding DiagnosticoCliente}"
                                                Width="180"
                                                ElementStyle="{StaticResource TextoCelda}"/>

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding Estado}"
                                                Width="125"
                                                ElementStyle="{StaticResource TextoCelda}"/>

                            <!-- ACCIONES -->
                            <DataGridTemplateColumn Header="Acciones"
                                                    Width="95">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">

                                            <Button Content="✎"
                                                    Width="34"
                                                    Height="30"
                                                    Margin="0,0,5,0"
                                                    Background="#E8F1FF"
                                                    Foreground="#0866CC"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    Click="EditarRegistro_Click"/>

                                            <Button Content="✕"
                                                    Width="34"
                                                    Height="30"
                                                    Background="#FDECEF"
                                                    Foreground="#DC3545"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Tag="{Binding}"
                                                    Click="EliminarRegistro_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- PANEL DE DETALLE -->
            <Border Grid.Column="2"
                    Style="{StaticResource TarjetaRegistro}"
                    Padding="16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Detalle del registro"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="#122244"
                                   TextWrapping="Wrap"/>

                        <Border Grid.Column="1"
                                Background="#E1ECFF"
                                CornerRadius="10"
                                Padding="9,5"
                                Margin="6,0,0,0"
                                VerticalAlignment="Top">

                            <TextBlock x:Name="TxtIdDetalle"
                                       Text="-"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#0866CC"/>
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <TextBlock Text="Cliente"
                                       Style="{StaticResource EtiquetaDetalle}"/>
                            <TextBlock x:Name="TxtDetalleCliente"
                                       Style="{StaticResource ValorDetalle}"/>

                            <TextBlock Text="Teléfono"
                                       Style="{StaticResource EtiquetaDetalle}"/>
                            <TextBlock x:Name="TxtDetalleTelefono"
                                       Style="{StaticResource ValorDetalle}"/>

                            <TextBlock Text="Fecha de recepción"
                                       Style="{StaticResource EtiquetaDetalle}"/>
                            <TextBlock x:Name="TxtDetalleFecha"
                                       Style="{StaticResource ValorDetalle}"/>

                            <TextBlock Text="Tipo de equipo"
                                       Style="{StaticResource EtiquetaDetalle}"/>
                            <TextBlock x:Name="TxtDetalleTipo"
                                       Style="{StaticResource ValorDetalle}"/>

                            <TextBlock Text="Marca"
                                       Style="{StaticResource EtiquetaDetalle}"/>
                            <TextBlock x:Name="TxtDetalleMarca"
                                       Style="{StaticResource ValorDetalle}"/>

                            <TextBlock Text="Modelo"
                                       Style="{StaticResource EtiquetaDetalle}"/>
                            <TextBlock x:Name="TxtDetalleModelo"
                                       Style="{StaticResource ValorDetalle}"/>

                            <TextBlock Text="Serie"
                                       Style="{StaticResource EtiquetaDetalle}"/>
                            <TextBlock x:Name="TxtDetalleSerie"
                                       Style="{StaticResource ValorDetalle}"/>

                            <TextBlock Text="Diagnóstico del cliente"
                                       Style="{StaticResource EtiquetaDetalle}"/>
                            <TextBlock x:Name="TxtDetalleDiagnostico"
                                       Style="{StaticResource ValorDetalle}"/>

                            <TextBlock Text="Estado"
                                       Style="{StaticResource EtiquetaDetalle}"/>
                            <TextBlock x:Name="TxtDetalleEstado"
                                       Style="{StaticResource ValorDetalle}"/>

                            <Border Background="#E2E8F0"
                                    Height="1"
                                    Margin="0,8,0,18"/>

                            <TextBlock Text="Últimas actualizaciones"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#122244"
                                       Margin="0,0,0,12"/>

                            <ItemsControl x:Name="ListaActualizaciones">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC"
                                                BorderBrush="#DFE5ED"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10"
                                                Margin="0,0,0,7">

                                            <StackPanel>
                                                <TextBlock Text="{Binding Fecha, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                           FontSize="12"
                                                           Foreground="#64748B"/>

                                                <TextBlock Text="{Binding Descripcion}"
                                                           FontSize="13"
                                                           Foreground="#142443"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="TxtSinActualizaciones"
                                       Text="Sin actualizaciones."
                                       FontSize="13"
                                       Foreground="#64748B"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
